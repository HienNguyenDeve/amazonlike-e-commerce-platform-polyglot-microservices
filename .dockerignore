# Only Maven build inputs enter the context; no local JARs, Git history or env files.
**
!pom.xml
!mvnw
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
!services/
!shared/
!shared/shared-common/
!shared/shared-common/pom.xml
!shared/shared-common/src/
!shared/shared-common/src/main/
!shared/shared-common/src/main/**
!services/auth-service/
!services/auth-service/pom.xml
!services/auth-service/src/
!services/auth-service/src/main/
!services/auth-service/src/main/**
!services/user-service/
!services/user-service/pom.xml
!services/user-service/src/
!services/user-service/src/main/
!services/user-service/src/main/**
!services/api-gateway/
!services/api-gateway/pom.xml
!services/api-gateway/src/
!services/api-gateway/src/main/
!services/api-gateway/src/main/**
# Deny sensitive files even under an allowed source directory.
**/.env
**/.env.*
**/.aws/**
**/.ssh/**
**/*credentials*
**/secrets/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/application-local.*
**/application-dev.*
**/application-test.*
